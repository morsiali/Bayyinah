# ── Bayyinah configuration ─────────────────────────────────────────────
# Copy to .env (npm run setup does this for you and generates AUTH_SECRET).

# Database. Local default is a SQLite file inside prisma/. See docs/OPERATIONS.md for PostgreSQL.
DATABASE_URL="file:./dev.db"

# Signs session cookies. 32+ random characters. Changing it signs everyone out.
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL (used in invitation and password-reset links). Use https:// in production.
APP_URL="http://localhost:3000"

# Private file storage directory (outside the web root).
STORAGE_DIR="./storage"

# ── AI analysis provider ───────────────────────────────────────────────
# Leave AI_PROVIDER empty to auto-select from the first key present
# (Anthropic → OpenAI → Abacus). With no key, the local rules analyzer is used
# and nothing leaves the server. Values: anthropic | openai | abacus | local
AI_PROVIDER=""
AI_MODEL=""                 # optional override, e.g. claude-sonnet-4-5, gpt-4o-mini, gpt-5.4-mini
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""          # optional, for OpenAI-compatible endpoints
ABACUSAI_API_KEY=""

# ── Development conveniences ───────────────────────────────────────────
# Shows the fictional seed accounts on the sign-in page. Set to false in production.
SHOW_DEMO_ACCOUNTS="true"

# Public contact address shown in the site footer (placeholder on a reserved domain by default).
NEXT_PUBLIC_CONTACT_EMAIL=""
